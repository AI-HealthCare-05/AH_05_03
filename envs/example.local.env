# docker
DOCKER_USER=ozcodingschool
DOCKER_REPOSITORY=ai-health

# fastapi
APP_VERSION=v1.0.0
SECRET_KEY=oz-codingschool-AI-health260127!@

# ai-worker
AI_WORKER_VERSION=v1.0.0

# db
DB_HOST=localhost
DB_PORT=5432
DB_EXPOSE_PORT=5432
DB_USER=ozcoding
DB_PASSWORD=pw1234
DB_NAME=ai_health
DB_TEST_NAME=ai_health_test

# redis
# docker compose로 띄우면 fastapi 컨테이너 안에서는 REDIS_URL이 redis://redis:6379/0로
# 오버라이드된다(docker-compose.yml 참고). 아래 값은 uv run으로 호스트에서 직접 띄울 때 쓴다.
REDIS_URL=redis://localhost:6379/0
ENABLE_DEV_OCR_BRIDGE=false
DEV_OCR_MAX_FILE_BYTES=20971520
NAVER_OCR_URL=
NAVER_OCR_SECRET=
