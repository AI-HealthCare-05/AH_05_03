# docker
DOCKER_USER=ozcodingschool
DOCKER_REPOSITORY=ai-health

# fastapi
APP_VERSION=v1.0.0
SECRET_KEY=oz-codingschool-AI-health260127!@

# ai-worker
AI_WORKER_VERSION=v1.0.0

# db
DB_HOST=postgres
DB_PORT=5432
DB_EXPOSE_PORT=5432
DB_USER=ozcoding
DB_PASSWORD=Password1234@
DB_NAME=ai_health
DB_TEST_NAME=ai_health_test

# redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0

# --- 브라우저 출처 (선택) ------------------------------------------
# 보통은 비워 둔다. 앱이 요청이 도착한 주소(Host + X-Forwarded-Proto)를 자기
# 오리진으로 인정하므로, SPA 를 FastAPI 가 같이 서빙하는 이 배포 형태에서는
# 어느 도메인에 올리든 회원가입·로그인이 그대로 된다.
#
# 프런트를 API 와 **다른 오리진**에 따로 띄울 때만 적는다. 스킴·호스트·포트까지
# 정확히 일치해야 하고, JSON 배열로 쓴다.
# CORS_ALLOW_ORIGINS=["https://front.example"]

# 가족 초대 메일 링크의 앞부분. 초대를 만든 요청의 오리진을 실어 보내므로 보통
# 비워 둔다. 이 값은 그 오리진을 못 잡았을 때의 최후 기본값이다.
# INVITATION_WEB_ORIGIN=https://your-domain.example

# --- 운영 하드닝 ----------------------------------------------------
# 대화형 API 문서와 OpenAPI 스키마를 끈다. 켜 두면 `/api/openapi.json` 이 라우트·
# 필드·오류 코드 전부를 익명에게 내준다(2026-09-04 실측 211KB).
API_DOCS_ENABLED=false

# 오류 응답의 details 는 비규격 필드다. 운영에서는 끈다.
API_ERROR_INCLUDE_DETAILS=false
