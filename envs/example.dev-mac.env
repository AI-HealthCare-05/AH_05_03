# Copy this file to ~/.config/ieobom/dev.env on the admin MacBook.
# Do not place the real file inside the repository checkout.

SECRET_KEY=replace-with-a-long-random-secret

DB_USER=ieobom
DB_PASSWORD=replace-with-a-long-random-database-password
DB_NAME=ieobom_dev
DB_TEST_NAME=ieobom_test

# DBeaver용 PostgreSQL 포트. 기본값은 admin Mac 안에서만 접근 가능하다.
# 팀 공유 시 DEV_DB_BIND_HOST를 admin Mac의 Tailscale IPv4로만 변경한다.
# 0.0.0.0 또는 LAN IP에는 바인딩하지 않는다.
DEV_DB_BIND_HOST=127.0.0.1
DEV_DB_PORT=15432

# Mailpit Web UI는 기본적으로 admin Mac에서만 보인다. 팀 공유가 필요하면
# GitHub Environment의 IEOBOM_DEV_TAILSCALE_HOST에 Tailscale IPv4를 둔다.
# SMTP 1025 포트는 어떤 경우에도 호스트에 공개하지 않는다.
DEV_MAILPIT_BIND_HOST=127.0.0.1
DEV_MAILPIT_WEB_PORT=8025
# 기본값은 공식 GHCR 이미지와 검증된 digest를 사용한다. 긴급한 교체 때만 재정의한다.
# MAILPIT_IMAGE=ghcr.io/axllent/mailpit:v1.30.6@sha256:...

# 초대 메일 링크가 팀 공유 dev 화면을 가리키도록 설정한다.
# 실제 Tailscale 주소는 GitHub Environment 변수로 관리한다.
INVITATION_WEB_ORIGIN=http://127.0.0.1:8080

# Use the exact browser origins that may open the admin Mac deployment.
# Add the MacBook LAN address only when LAN access is required.
CORS_ALLOW_ORIGINS=["http://localhost:8080"]

# The admin Mac dev deployment uses HTTP by default. Switch these values when TLS is added.
REFRESH_COOKIE_NAME=ieobom_refresh
REFRESH_COOKIE_SECURE=false
REFRESH_COOKIE_SAMESITE=lax
API_ERROR_INCLUDE_DETAILS=false

DEV_HTTP_PORT=8080
